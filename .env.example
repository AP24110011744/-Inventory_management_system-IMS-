# Copy this file to .env in the project root.
# Do not place .env inside the drizzle folder.
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/inventory_db
NODE_ENV=development
PORT=3000

# Secret used to sign login sessions. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Optional: only needed if you add Manus OAuth login.
# MANUS_OAUTH_API_URL=
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
